  <td height=12 class=xl27 width=369 style='height:9.0pt;width:277pt'>Dargli un
  avvertimento/ ammonirlo</td>
  <td colspan=5 class=xl26 style='mso-ignore:colspan'>&nbsp;</td>
  <td class=xl35 align=right width=75 style='width:56pt' x:num="12.9">12,9</td>
  <td class=xl24>&nbsp;</td>
 </tr>
 <tr height=12 style='mso-height-source:userset;height:9.0pt'>
  <td height=12 class=xl27 width=369 style='height:9.0pt;width:277pt'>Prendere
  più seriamente denuncia/ ascoltarla/ darle maggior appoggio</td>
  <td colspan=5 class=xl26 style='mso-ignore:colspan'>&nbsp;</td>
  <td class=xl35 align=right width=75 style='width:56pt' x:num="18.3">18,3</td>
