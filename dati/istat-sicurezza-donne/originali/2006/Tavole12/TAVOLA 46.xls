 </tr>
 <tr height=12 style='mso-height-source:userset;height:9.0pt'>
  <td height=12 class=xl27 width=369 style='height:9.0pt;width:277pt'>Fornire
  protezione aiutarla ad andare via di casa</td>
  <td colspan=5 class=xl26 style='mso-ignore:colspan'>&nbsp;</td>
  <td class=xl35 align=right width=75 style='width:56pt' x:num="3">3,0</td>
