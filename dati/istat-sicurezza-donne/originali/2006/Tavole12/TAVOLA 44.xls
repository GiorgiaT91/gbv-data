  <td class=xl40 width=90 style='width:68pt' x:num="4">4,0</td>
  <td class=xl40 width=88 style='width:66pt' x:num="95.6">95,6</td>
  <td class=xl40 width=90 style='width:68pt' x:num="0.4">0,4</td>
  <td class=xl40 width=69 style='width:52pt' x:num="100">100,0</td>
 </tr>
 <![if supportMisalignedColumns]>
 <tr height=0 style='display:none'>
  <td width=211 style='width:158pt'></td>
  <td width=90 style='width:68pt'></td>
  <td width=88 style='width:66pt'></td>
  <td width=90 style='width:68pt'></td>
  <td width=69 style='width:52pt'></td>
 </tr>
 <![endif]>
</table>

</body>

</html>
