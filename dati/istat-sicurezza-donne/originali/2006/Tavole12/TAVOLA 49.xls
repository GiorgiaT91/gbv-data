 <tr height=50 style='mso-height-source:userset;height:37.5pt'>
  <td colspan=16 height=50 class=xl37 width=629 style='height:37.5pt;
  width:474pt'><a name=IDX1>Tavola 49 - Donne dai 16 ai 70 anni che hanno
  subito violenza da un uomo non partner e che non hanno <br>
    <span style='mso-spacerun:yes'>                     </span>denunciato il
  fatto, per motivi della non denuncia, ripartizione geografica e tipo di comune
  - <br>
    <span style='mso-spacerun:yes'>                     </span>Anno 2006<font
  class="font7"> (per 100 vittime della stessa zona)</font></a></td>
 </tr>
 <tr height=14 style='mso-height-source:userset;height:10.5pt'>
  <td height=14 class=xl25 style='height:10.5pt'>&nbsp;</td>
  <td colspan=15 class=xl24 style='mso-ignore:colspan'>&nbsp;</td>
 </tr>
 <tr height=131 style='mso-height-source:userset;height:98.25pt'>
  <td height=131 class=xl26 width=86 style='height:98.25pt;width:65pt'></colgroup></colgroup>&nbsp;</td>
  <td class=xl27 width=38 style='width:29pt'>Ho gestito la situa-<br>
    zione da sola</td>
  <td class=xl27 width=41 style='width:31pt'>Fatto non grave</td>
  <td class=xl27 width=41 style='width:31pt'>La polizia non avrebbe fatto
  niente</td>
  <td class=xl27 width=39 style='width:29pt'>La polizia non avrebbe potuto fare
  niente</td>
  <td class=xl27 width=39 style='width:29pt'>Paura dell'aggressore</td>
  <td class=xl27 width=35 style='width:26pt'>Per vergo-<br>
    gna</td>
  <td class=xl27 width=43 style='width:32pt'>Non volevo che qualcuno lo sapesse</td>
  <td class=xl27 width=34 style='width:26pt'>Non volevo che venis-<br>
    se arresta-<br>
    to</td>
  <td class=xl27 width=36 style='width:27pt'>Non sarei stata creduta</td>
  <td class=xl27 width=32 style='width:24pt'>Fa parte dei rischi del lavoro</td>
  <td class=xl27 width=36 style='width:27pt'>Lo ha denun-<br>
    ciato a qual-<br>
    cun altro</td>
  <td class=xl27 width=26 style='width:20pt'>Era trop-<br>
    po pic-<br>
    cola</td>
  <td class=xl27 width=32 style='width:24pt'>Altro</td>
  <td class=xl27 width=26 style='width:20pt'>Non sa/<br>
    non ri-<br>
    spon-<br>
    de</td>
  <td class=xl27 width=45 style='width:34pt'>Totale*</td>
 </tr>
 <tr height=12 style='mso-height-source:userset;height:9.0pt'>
  <td height=12 colspan=16 class=xl28 style='height:9.0pt;mso-ignore:colspan'>&nbsp;</td>
 </tr>
