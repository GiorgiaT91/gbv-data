---
// Pagina corta di una domanda (modello delle domande 1, 2, 3 e 6):
// la domanda, un numero grande con due righe, poi un riquadro per ogni fonte (rapporto 1 a 1 fra fonte e infografica).
// Toccando un riquadro l'infografica della fonte si apre sotto, nella stessa pagina: uno aperto alla volta,
// nessuno aperto all'avvio (stesso modello dei riquadri degli stereotipi). Le fonti non ancora pronte
// sono nominate nella nota sotto i riquadri (fonti.in_lavorazione). La pagina della fonte resta come scheda completa.
// Testi in contenuti/domande/<numero>-<indirizzo>.yaml; la domanda deve avere modello "corta" in contenuti/domande.yaml.
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../componenti/Layout.astro';
import AvvisoVerifica from '../../componenti/AvvisoVerifica.astro';
import InfograficaFonte from '../../componenti/InfograficaFonte.astro';
import { contenuto, richiesto, formatta, scheda } from '../../lib/dati.js';
import { domande, fonte, dataEstesa as data } from '../../lib/registro.js';
import { url } from '../../lib/url.js';
import { fmt } from '../../lib/testo.js';
import { percentuale } from '../../lib/colori.js';

export function getStaticPaths() {
  const cartella = path.join(process.cwd(), 'contenuti', 'domande');
  return domande()
    .filter((d) => d.modello === 'corta' && d.stato !== 'in-lavorazione')
    .map((d) => {
      const file = fs.readdirSync(cartella).find((f) => f.startsWith(`${d.id}-`) && f.endsWith('.yaml'));
      const t = contenuto('domande', file);
      return { params: { indirizzo: t.indirizzo }, props: { file, d } };
    });
}

const { file, d } = Astro.props;
const t = contenuto('domande', file);
const ng = t.numero_grande;
const mostra = (x) => (Number.isInteger(x) ? formatta(x) : `${percentuale(x, 1)}%`);
const grande = mostra(richiesto(ng.fonte, ng.filtro));
let testoGrande = ng.testo;
for (const [k, val] of Object.entries(ng.valori ?? {})) testoGrande = testoGrande.replace(`{${k}}`, mostra(richiesto(val.fonte, val.filtro)));

const riquadri = t.fonti.voci.map((voce) => {
  const barre = voce.anteprima.barre.map((b) => ({ ...b, valore: richiesto(voce.id, b.filtro) }));
  const massimo = Math.max(...barre.map((b) => b.valore));
  return { ...voce, barre, massimo, inVerifica: fonte(voce.id)?.in_verifica, s: scheda(voce.id) };
});
const inVerifica = riquadri.some((r) => r.inVerifica);
---
<Layout titolo={t.domanda} descrizione={`${grande} ${testoGrande.replace(/\*\*/g, '')}`} sezione="domande">
  <section class="apertura">
    <a class="briciole" href={url('/')}>Le domande</a>
    <h1 class="domanda-titolo">{t.domanda}</h1>
    <p class="grande">{grande}</p>
    <p class="attacco" set:html={fmt(testoGrande)} />
    <p class="nota">{ng.nota}</p>
    {inVerifica && <AvvisoVerifica />}
  </section>

  <section class="sezione">
    <div class="intestazione">
      <h2>{t.fonti.titolo}</h2>
      <p class="sottotitolo">{t.fonti.sottotitolo}</p>
    </div>
    <div class="fonti-hub">
      {riquadri.map((r, i) => (
        <>
          <button type="button" class="fonte-box" id={`fonte-b-${r.id}`} data-fonte-pannello={`fonte-p-${r.id}`} aria-expanded="false" aria-controls={`fonte-p-${r.id}`} style={`--o:${2 * i}`}>
            <span class="etichetta">{r.etichetta}</span>
            <span class="titolo">{r.titolo}</span>
            <span class="anteprima" style={r.anteprima.etichette ? `--etichetta:${r.anteprima.etichette}px` : undefined} role="img" aria-label={`${r.anteprima.descrizione}: ${r.barre.map((b) => `${b.etichetta} ${mostra(b.valore)}`).join(', ')}`}>
              <span class="piccola">{r.anteprima.descrizione}</span>
              {r.barre.map((b, j) => (
                <span class="barra">
                  <span>{b.etichetta}</span>
                  <span class="traccia">
                    <span class:list={['pieno', { ultimo: j === (r.anteprima.evidenzia ?? r.barre.length - 1) }]} style={`width:${(85 * b.valore) / r.massimo}%`}></span>
                    <strong>{mostra(b.valore)}</strong>
                  </span>
                </span>
              ))}
              {r.anteprima.nota && <span class="piccola">{r.anteprima.nota}</span>}
            </span>
            <span class="fonte-piede"><span>{r.piede}</span><span class="apri"><span class="o">Apri l'infografica</span><span class="c">Chiudi</span> <i aria-hidden="true">↓</i></span></span>
          </button>
          <section class="fonte-pannello" id={`fonte-p-${r.id}`} aria-labelledby={`fonte-t-${r.id}`} style={`--o:${2 * i}`} hidden>
            <div class="pannello-testa">
              <p class="meta">{r.s.ente} · {r.s.nome} · ultimo aggiornamento {data(r.s.ultimo_aggiornamento)}</p>
              <h3 id={`fonte-t-${r.id}`}>{r.s.titolo_messaggio}</h3>
            </div>
            <div class="infografica">
              <InfograficaFonte id={r.id} />
            </div>
            <div class="dettagli">
              <details class="limiti">
                <summary>Questo dato basta?</summary>
                <ul>{r.s.limiti.map((l) => <li>{l}</li>)}</ul>
              </details>
              <details class="scheda">
                <summary>La fonte</summary>
                <dl>
                  <div><dt>Chi conta</dt><dd>{r.s.chi_conta}</dd></div>
                  <div><dt>Che cosa viene contato</dt><dd>{r.s.cosa_viene_contato}</dd></div>
                  <div><dt>Periodo coperto</dt><dd>{r.s.periodo_coperto}</dd></div>
                </dl>
                <p class="collegamenti"><a href={url(`/fonti/${r.id}/`)}>Scheda completa della fonte</a> · <a href={r.s.link_fonte}>Fonte originale</a></p>
              </details>
            </div>
          </section>
        </>
      ))}
    </div>
    {t.fonti.in_lavorazione && <p class="nota">{t.fonti.in_lavorazione}</p>}
  </section>

  {t.nuove_domande && (
    <section class="sezione">
      <h2>{t.nuove_domande.titolo}</h2>
      <ul class="nuove">{t.nuove_domande.voci.map((q) => <li set:html={fmt(q)} />)}</ul>
    </section>
  )}
</Layout>

<script>
  // Un riquadro aperto alla volta; un secondo tocco sullo stesso lo chiude (come nei riquadri degli stereotipi).
  const riquadri = [...document.querySelectorAll<HTMLButtonElement>('.fonti-hub > .fonte-box[data-fonte-pannello]')];
  const riduci = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  riquadri.forEach((b) => b.addEventListener('click', () => {
    const aperto = b.getAttribute('aria-expanded') === 'true';
    riquadri.forEach((x) => {
      x.setAttribute('aria-expanded', 'false');
      document.getElementById(x.dataset.fontePannello!)!.hidden = true;
    });
    if (aperto) return;
    b.setAttribute('aria-expanded', 'true');
    const p = document.getElementById(b.dataset.fontePannello!)!;
    p.hidden = false;
    // I grafici misurano la larghezza: avvisa che lo spazio è cambiato
    window.dispatchEvent(new Event('resize'));
    const top = p.getBoundingClientRect().top;
    if (top > innerHeight * 0.8 || top < 0) p.scrollIntoView({ block: 'start', behavior: riduci() ? 'auto' : 'smooth' });
  }));
</script>

<style>
  .domanda-titolo { font-size: clamp(30px, 5vw, 44px) !important; color: var(--testo-2); font-weight: 500; }
  .grande { font-family: var(--titoli); font-weight: 600; font-size: clamp(72px, 14vw, 120px); line-height: 1; color: var(--accento); }
  /* Riquadri delle fonti: stesso modello di componenti/infografiche/IstatStereotipi.astro */
  .fonti-hub { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; align-items: stretch; }
  .fonte-box {
    all: unset; box-sizing: border-box; cursor: pointer; min-width: 0;
    display: flex; flex-direction: column; gap: 16px; padding: 24px;
    background: var(--carta); border: 1px solid var(--bordo); border-radius: 16px; color: var(--testo);
  }
  .fonte-box:hover { border-color: var(--accento); }
  .fonte-box:focus-visible { outline: 3px solid var(--accento); outline-offset: 2px; }
  .fonte-box[aria-expanded="true"] { border: 2px solid var(--accento); padding: 23px; background: var(--accento-chiaro); }
  .etichetta { font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--testo-3); }
  .titolo { font-family: var(--titoli); font-size: 22px; font-weight: 600; line-height: 1.2; }
  .anteprima { display: flex; flex-direction: column; gap: 10px; }
  .piccola { font-size: 13px; color: var(--testo-3); }
  .barra { display: grid; grid-template-columns: var(--etichetta, 48px) 1fr; align-items: center; gap: 10px; font-size: 14px; }
  .traccia { display: flex; align-items: center; gap: 8px; }
  .pieno { height: 20px; background: var(--lilla-medio); border-radius: 4px; }
  .pieno.ultimo { background: var(--accento); }
  .fonte-piede { margin-top: auto; padding-bottom: 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 16px; border-top: 1px solid var(--bordo); font-size: 14px; color: var(--testo-3); }
  .apri { font-size: 16px; font-weight: 600; color: var(--link); white-space: nowrap; }
  .apri i { font-style: normal; display: inline-block; transition: transform .2s; }
  .fonte-box .c { display: none; }
  .fonte-box[aria-expanded="true"] .c { display: inline; }
  .fonte-box[aria-expanded="true"] .o { display: none; }
  .fonte-box[aria-expanded="true"] .apri i { transform: rotate(180deg); }

  /* Pannello aperto: occupa tutta la riga, sotto i riquadri */
  .fonte-pannello { grid-column: 1 / -1; order: 1000; min-width: 0; display: flex; flex-direction: column; gap: 24px; padding-top: 16px; }
  .fonte-pannello[hidden] { display: none; }
  .pannello-testa { display: flex; flex-direction: column; gap: 8px; }
  .meta { font-size: 14px; color: var(--testo-3); }
  .pannello-testa h3 { font-size: clamp(24px, 3.6vw, 32px); line-height: 1.2; }
  .infografica { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .dettagli { display: flex; flex-direction: column; gap: 10px; }
  details { border-radius: 12px; }
  summary { cursor: pointer; padding: 14px 20px; font-weight: 600; }
  details.limiti { background: var(--limiti-fondo); color: var(--limiti-testo); }
  details.limiti summary { color: var(--limiti-titolo); }
  details.limiti ul { margin: 0; padding: 0 20px 16px 40px; display: flex; flex-direction: column; gap: 8px; }
  details.scheda { background: var(--carta); border: 1px solid var(--bordo); }
  details.scheda dl { margin: 0; }
  details.scheda dl div { display: grid; grid-template-columns: minmax(160px, 1fr) 3fr; gap: 16px; padding: 12px 20px; border-top: 1px solid var(--bordo-chiaro); }
  details.scheda dt { font-weight: 600; }
  details.scheda dd { margin: 0; color: var(--testo-2); }
  .collegamenti { padding: 12px 20px 16px; border-top: 1px solid var(--bordo-chiaro); font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .fonte-pannello { animation: fonte-apri .2s ease-out; }
    @keyframes fonte-apri { from { opacity: .4; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  }
  /* Su telefono una colonna: ogni pannello si apre subito sotto il suo riquadro */
  @media (max-width: 700px) {
    .fonti-hub { grid-template-columns: minmax(0, 1fr); }
    .fonte-box { order: var(--o); }
    .fonte-pannello { order: calc(var(--o) + 1); }
    details.scheda dl div { grid-template-columns: 1fr; gap: 4px; }
  }
  .nuove { margin: 0; padding: 0; list-style: none; }
  .nuove li { font-family: var(--titoli); font-size: 21px; padding: 16px 0; border-top: 1px solid var(--bordo); }
  @media (max-width: 640px) { .fonte-box { padding: 20px; } .fonte-box[aria-expanded="true"] { padding: 19px; } .titolo { font-size: 20px; } .nuove li { font-size: 18px; } }
</style>
