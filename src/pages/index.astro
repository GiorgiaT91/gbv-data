---
import Layout from '../componenti/Layout.astro';
import { url } from '../lib/url.js';
import { domande, fonte } from '../lib/registro.js';

// Nome breve dell'ente: la parte prima della virgola ("Ministero dell'Interno, Servizio…").
const enteBreve = (e = '') => e.split(',')[0];
const elenco = domande().map((d) => ({
  ...d,
  enti: [...new Set(d.fonti.filter((id) => fonte(id)?.pronta).map((id) => enteBreve(fonte(id).ente)))],
}));
const pronte = elenco.filter((d) => d.stato === 'pronta').length;
const online = (d) => d.stato === 'pronta' || d.stato === 'in-verifica';
---
<Layout descrizione="Che cosa sappiamo sulla violenza di genere e sui femminicidi in Italia, e che cosa non sappiamo." sezione="domande">
  <section class="apertura">
    <h1>Che cosa sappiamo sulla violenza contro le donne in Italia?</h1>
    <p class="attacco">Sei domande. Per ognuna, i dati con cui oggi si prova a rispondere e le domande che quei dati lasciano aperte.</p>
  </section>

  <section class="sezione" aria-labelledby="titolo-domande">
    <h2 id="titolo-domande" class="visivamente-nascosto">Le domande</h2>
    <ul class="domande">
      {elenco.map((d) => (
        <li>
          {online(d) ? (
            <a href={url(d.indirizzo)} class="voce pronta">
              <span class="testo">{d.testo}</span>
              {d.enti.length > 0 && <span class="fonti">{d.enti.join(' · ')}{d.stato === 'in-verifica' && <span class="verifica"> · in verifica</span>}</span>}
              <span class="vai" aria-hidden="true">→</span>
            </a>
          ) : (
            <div class="voce">
              <span class="testo">{d.testo}</span>
              <span class="stato">In lavorazione</span>
            </div>
          )}
        </li>
      ))}
    </ul>
    {pronte < elenco.length && (
      <p class="nota">Le domande in lavorazione vengono pubblicate quando i loro dati sono stati controllati sugli originali. Ogni novità è registrata in <a href={url('/cosa-e-cambiato/')}>Cosa è cambiato</a>.</p>
    )}
  </section>
</Layout>

<style>
  .domande { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .voce {
    display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 16px; row-gap: 4px;
    padding: 20px 24px; background: var(--carta); border: 1px solid var(--bordo); border-radius: 12px; color: var(--testo-3);
  }
  .pronta { text-decoration: none; color: var(--testo); }
  .pronta:hover { border-color: var(--accento); color: var(--testo); }
  .testo { font-family: var(--titoli); font-size: 22px; font-weight: 500; line-height: 1.25; }
  .fonti { grid-column: 1; font-size: 14px; color: var(--testo-3); }
  .vai { grid-column: 2; grid-row: 1 / span 2; font-size: 24px; color: var(--accento); }
  .verifica { color: var(--attenzione); font-weight: 500; }
  .stato {
    font-size: 13px; font-weight: 500; color: var(--testo-3); background: var(--grigio);
    padding: 4px 10px; border-radius: 999px; white-space: nowrap;
  }
  @media (max-width: 640px) {
    .voce { padding: 16px 18px; }
    .testo { font-size: 19px; }
  }
</style>
