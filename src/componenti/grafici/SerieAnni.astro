---
// Serie annuale compatta, pensata per stare in tre o quattro per riga.
// Mostra il valore del primo e dell'ultimo anno; gli altri sono nell'etichetta accessibile.
// valori: [{ anno, valore, provvisorio? }]; rottura: anno da cui cambia il modo di contare (linea tratteggiata).
import { C } from '../../lib/colori.js';
import { formatta } from '../../lib/dati.js';

const { valori, colore = C.accento, rottura, massimo, descrizione, titolo } = Astro.props;
const L = 360, A = 190, x0 = 6, x1 = L - 6, yTop = 30, yBase = A - 26;
const max = massimo ?? Math.max(...valori.map((d) => d.valore));
const pass = (x1 - x0) / valori.length;
const larg = Math.max(4, pass * 0.66);
const barre = valori.map((d, i) => {
  const h = ((yBase - yTop) * d.valore) / max;
  return { ...d, x: x0 + i * pass + (pass - larg) / 2, y: yBase - h, h, cx: x0 + i * pass + pass / 2 };
});
const primo = barre[0], ultimo = barre[barre.length - 1];
const linea = rottura ? barre.find((b) => b.anno === rottura) : null;
const etichetta = descrizione ?? `${titolo}: ${valori.map((d) => `${d.anno} ${formatta(d.valore)}`).join(', ')}`;
---
<figure class="serie">
  {titolo && <figcaption>{titolo}</figcaption>}
  <svg role="img" aria-label={etichetta} viewBox={`0 0 ${L} ${A}`}>
    <line x1={x0} x2={x1} y1={yBase} y2={yBase} stroke={C.bordo} />
    {barre.map((b) => (
      b.provvisorio
        ? <rect x={b.x} y={b.y} width={larg} height={b.h} fill={C.bianco} stroke={colore} stroke-width="1.5" stroke-dasharray="4 2" />
        : <rect x={b.x} y={b.y} width={larg} height={b.h} fill={colore} opacity={b === ultimo ? 1 : 0.55} />
    ))}
    {linea && <line x1={linea.x - (pass - larg) / 2} x2={linea.x - (pass - larg) / 2} y1={yTop - 22} y2={yBase} stroke={C.testo3} stroke-dasharray="3 3" />}
    <text x={primo.cx} y={primo.y - 6} text-anchor="start" font-size="15" font-weight="600" fill={C.testo}>{formatta(primo.valore)}</text>
    <text x={ultimo.cx} y={ultimo.y - 6} text-anchor="end" font-size="15" font-weight="600" fill={C.testo}>{formatta(ultimo.valore)}</text>
    <text x={primo.x} y={A - 6} font-size="14" fill={C.testo3}>{primo.anno}</text>
    <text x={ultimo.x + larg} y={A - 6} text-anchor="end" font-size="14" fill={C.testo3}>{ultimo.anno}{ultimo.provvisorio ? '*' : ''}</text>
  </svg>
</figure>

<style>
  .serie { margin: 0; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  figcaption { font-size: 14px; font-weight: 600; }
  svg { width: 100%; height: auto; }
</style>
