---
// Elenco di numeri grandi con una descrizione accanto.
// voci: [{ numero, testo, colore? }]
import { C } from '../../lib/colori.js';
const { voci } = Astro.props;
---
<ul class="cifre">
  {voci.map((v, i) => (
    <li>
      <span class="numero" style={`color:${v.colore ?? (i === 0 ? C.accento : C.uomini)}`}>{v.numero}</span>
      <span class="testo">{v.testo}</span>
    </li>
  ))}
</ul>

<style>
  .cifre { list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: baseline; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--griglia); }
  .numero { font-family: var(--titoli); font-weight: 600; font-size: 40px; line-height: 1; min-width: 130px; }
  .testo { font-size: 14px; line-height: 1.4; }
  @media (max-width: 640px) { .numero { font-size: 32px; min-width: 104px; } }
</style>
