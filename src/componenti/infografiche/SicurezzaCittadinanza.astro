---
// Italiane e straniere (2014, scelta da Giorgia il 20/11/2026): in alto due quadrati da 100 (quadratini = italiane,
// pallini = straniere, stesso colore); sotto un grafico a righe, una per gruppo: quadratino e pallino sullo stesso righello,
// uniti da una linea sottile, valori a destra. Forme diverse, non colori diversi. Periodo e forma dalla barra comune (`evento`).
// Con `popolazioni` (periodo → [italiane, straniere]) ogni periodo ha le sue popolazioni; se per un periodo o una forma
// il dato non c'è, il riquadro lo dice invece del grafico.
import { PERIODI, FORME_TUTTE, DIMENSIONI, cella } from '../../lib/sicurezza.js';

interface Props { anno: string; periodi: string[]; dimensioni: string[]; evento: string; nota: string; comandi: string;
  popolazioni?: Record<string, [string, string]>; sotto?: string; notaArea?: string }
const { anno, periodi, dimensioni, evento, nota, comandi, popolazioni = {},
  sotto = "Le donne italiane e straniere che vivono in Italia, ciascun gruppo calcolato sulle donne della stessa cittadinanza. La cittadinanza c'è solo nella rilevazione 2014.",
  notaArea = "Per l'area geografica il dato per cittadinanza non c'è." } = Astro.props;
const popDi = (p) => popolazioni[p] ?? ['italiane_16_70', 'straniere_16_70'];
const CORTO = { dirigenti: 'Dirigenti, libere prof.', direttive_impiegate: 'Impiegate e quadri', post_secondario: 'Laurea o più' };
const D = {};
for (const p of periodi) {
  D[p] = {};
  for (const [f] of FORME_TUTTE) {
    const [pi, ps] = popDi(p);
    const a = cella(anno, pi, p, f, 'totale', 'totale')?.v, b = cella(anno, ps, p, f, 'totale', 'totale')?.v;
    if (a === undefined || b === undefined) { D[p][f] = null; continue; }
    const righe = [{ t: 'Tutte', a, b, tot: true }];
    for (const d of dimensioni) {
      const gs = DIMENSIONI[d].gruppi.map(([g, t]) => ({ t: CORTO[g] || t, a: cella(anno, pi, p, f, d, g)?.v, b: cella(anno, ps, p, f, d, g)?.v }))
        .filter((r) => r.a !== undefined || r.b !== undefined);
      if (gs.length) righe.push({ h: DIMENSIONI[d].nome }, ...gs);
    }
    D[p][f] = righe;
  }
}
---
<section class="sic-blocco sic-ct">
  <h3>Italiane e straniere</h3>
  <p class="sic-ora"><span data-ora></span><a href={`#${comandi}`}>cambia</a></p>
  <p class="sic-sotto">{sotto}</p>
  <p class="sic-cl-nota" data-manca hidden></p>
  <div class="sic-ct-tot"></div>
  <div class="sic-ct-leg" aria-hidden="true"><span><i></i>Italiane</span><span><i class="t"></i>Straniere</span></div>
  <p class="sic-sotto">Gruppo per gruppo: più il segno è a destra, più alto è il valore; la linea sottile unisce italiane e straniere dello stesso gruppo.</p>
  <div class="sic-ct-graf"><svg role="img"></svg></div>
  <p class="sic-fonte">{nota} {notaArea}</p>
  <script type="application/json" class="sic-ct-json" set:html={JSON.stringify({ D, evento, forme: Object.fromEntries(FORME_TUTTE), periodi: PERIODI })}></script>
</section>

<style is:global>
  .sic-ct-tot { display:flex; flex-wrap:wrap; gap:28px; }
  .sic-ct-tot > div { display:grid; gap:6px; justify-items:start; }
  .sic-ct-tot .sic-cl-q { width:140px; max-width:140px; gap:2px; }
  .sic-ct-tot b { font-family:var(--titoli); font-size:1.5rem; font-variant-numeric:tabular-nums; }
  .sic-ct-tot span { font-size:.9rem; }
  .sic-ct-leg { display:flex; gap:18px; flex-wrap:wrap; font-size:.85rem; color:var(--testo-2); }
  .sic-ct-leg span { display:inline-flex; gap:6px; align-items:center; }
  .sic-ct-leg i { width:11px; height:11px; background:var(--accento); display:inline-block; }
  .sic-ct-leg i.t { border-radius:50%; }
  .sic-ct-graf svg { width:100%; max-width:600px; height:auto; display:block; font-family:var(--corpo); fill:var(--testo); }
</style>

<script>
  const fmt = (v: number) => v.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const stretto = window.matchMedia('(max-width: 640px)');
  const quadrato = (v: number, tondo: boolean) => `<span class="sic-cl-q${tondo ? ' tondo' : ''}" aria-hidden="true">${Array.from({ length: 100 }, (_, j) => `<i${j < Math.round(v) ? ' class="si"' : ''}></i>`).join('')}</span>`;
  document.querySelectorAll<HTMLElement>('.sic-ct').forEach((root) => {
    const J = JSON.parse(root.querySelector('.sic-ct-json')!.textContent!);
    const st = { p: Object.keys(J.D)[0], f: 'fisica_o_sessuale' };
    const svg = root.querySelector('svg[role="img"]')!;
    function disegna() {
      root.querySelector('[data-ora]')!.textContent = `${J.forme[st.f]}, ${J.periodi[st.p].toLowerCase()}.`;
      const righe = J.D[st.p][st.f];
      const manca = root.querySelector<HTMLElement>('[data-manca]')!;
      manca.hidden = !!righe;
      root.querySelectorAll<HTMLElement>('.sic-ct-tot, .sic-ct-leg, .sic-ct-graf, .sic-ct-graf ~ .sic-sotto').forEach((el) => { el.hidden = !righe; });
      root.querySelector<HTMLElement>('.sic-ct-leg + .sic-sotto')!.hidden = !righe;
      if (!righe) { manca.textContent = `Per questo periodo e questa forma Istat non dà il dato separato per italiane e straniere.`; return; }
      const tot = righe[0];
      const soloTot = righe.length === 1;
      root.querySelector<HTMLElement>('.sic-ct-graf')!.hidden = soloTot;
      root.querySelector<HTMLElement>('.sic-ct-leg + .sic-sotto')!.hidden = soloTot;
      root.querySelector('.sic-ct-tot')!.innerHTML = [['Italiane', tot.a, false], ['Straniere', tot.b, true]].map(([t, v, tondo]) =>
        `<div role="img" aria-label="${t}: ${fmt(v as number)}%, circa ${Math.round(v as number)} su 100">${quadrato(v as number, tondo as boolean)}<b>${fmt(v as number)}%</b><span>${t}: circa ${Math.round(v as number)} su 100</span></div>`).join('');
      const vals = righe.flatMap((r: any) => [r.a, r.b]).filter((v: any) => v !== undefined);
      const M = Math.max(20, Math.ceil(Math.max(...vals) / 10) * 10);
      const tel = stretto.matches, W = tel ? 340 : 480, X0 = tel ? 160 : 168, X1 = tel ? 266 : 372, RH = 21, HH = 26, top = 26;
      const x = (v: number) => X0 + (v / M) * (X1 - X0);
      let y = top, s = '', corpo = '';
      for (const r of righe) {
        if (r.h) { corpo += `<text x="4" y="${y + HH - 7}" font-size="12" font-weight="700" fill="var(--testo-2)">${r.h.toUpperCase()}</text>`; y += HH; continue; }
        const yy = y + RH / 2;
        corpo += `<line x1="${X0}" x2="${X1}" y1="${yy}" y2="${yy}" stroke="var(--griglia)"/>`;
        corpo += `<text x="${X0 - 8}" y="${yy + 4}" font-size="${tel ? 12 : 13}" text-anchor="end"${r.tot ? ' font-weight="700"' : ''}>${r.t}</text>`;
        if (r.a !== undefined && r.b !== undefined) corpo += `<line x1="${x(r.a)}" x2="${x(r.b)}" y1="${yy}" y2="${yy}" stroke="var(--testo-3)" stroke-width="1.5"/>`;
        if (r.b !== undefined) corpo += `<circle cx="${x(r.b)}" cy="${yy}" r="6.5" fill="var(--accento)" stroke="var(--carta)" stroke-width="1.5"><title>Straniere ${fmt(r.b)}%</title></circle>`;
        if (r.a !== undefined) corpo += `<rect x="${x(r.a) - 5}" y="${yy - 5}" width="10" height="10" fill="var(--accento)" stroke="var(--carta)" stroke-width="1.5"><title>Italiane ${fmt(r.a)}%</title></rect>`;
        corpo += `<text x="${X1 + (tel ? 8 : 12)}" y="${yy + 4}" font-size="${tel ? 10.5 : 12}" fill="var(--testo-2)"><tspan font-weight="700">${r.a === undefined ? '–' : fmt(r.a)}</tspan> · ${r.b === undefined ? '–' : fmt(r.b)}</text>`;
        y += RH;
      }
      for (let t = 0; t <= M; t += tel && M > 40 ? 20 : 10)
        s += `<line x1="${x(t)}" x2="${x(t)}" y1="${top - 4}" y2="${y}" stroke="var(--griglia)"/><text x="${x(t)}" y="${top - 10}" font-size="11" text-anchor="middle" fill="var(--testo-3)">${t}%</text>`;
      if (!tel) s += `<text x="${X1 + 30}" y="${top - 10}" font-size="11" fill="var(--testo-3)">ita · str</text>`;
      svg.setAttribute('viewBox', `0 0 ${W} ${y + 6}`);
      svg.innerHTML = s + corpo;
      svg.setAttribute('aria-label', righe.filter((r: any) => !r.h).map((r: any) => `${r.t}: italiane ${r.a === undefined ? 'n.d.' : fmt(r.a) + '%'}, straniere ${r.b === undefined ? 'n.d.' : fmt(r.b) + '%'}`).join('; '));
    }
    document.addEventListener(J.evento, (e: Event) => { const d = (e as CustomEvent).detail; st.p = d.p; st.f = d.f; disegna(); });
    stretto.addEventListener('change', disegna);
    disegna();
  });
</script>
