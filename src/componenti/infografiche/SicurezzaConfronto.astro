---
// Riquadro «confronto» della domanda 1 (rifatto su scelta di Giorgia il 24/11/2026, mockup «Le rilevazioni a confronto»).
// Le tre rilevazioni non formano una serie unica: due coppie sempre separate.
// 2006 → 2014 su tutte le donne di 16-70 anni (nella vita, ultimi 5 anni, ultimi 12 mesi);
// 2014 → 2025 solo sulle italiane di 16-70 anni e solo per gli ultimi 5 anni. Il 2025 «nella vita» (16-75 anni) non si confronta.
// Parte 1: per ogni coppia due quadrati da 100; nel secondo i quadratini vuoti sono le donne «in meno», quelli con il punto le donne «in più».
// Parte 2: pendenze gruppo per gruppo, una per coppia; all'avvio nessuna caratteristica scelta; tutte le donne = linea tratteggiata.
// Periodo e forma si scelgono nella prima parte e valgono anche per la seconda. Colori: solo variabili di globale.css.
import { FORME, PERIODI, DIMENSIONI, cella } from '../../lib/sicurezza.js';

const ORDINE = ['ultimi_5_anni', 'nella_vita', 'ultimi_12_mesi'];
const COPPIE = {
  A: { anni: ['2006', '2014'], pop: ['tutte_16_70', 'tutte_16_70'], testo: 'Tutte le donne di 16–70 anni' },
  B: { anni: ['2014', '2025'], pop: ['italiane_16_70', 'italiane_16_70'], testo: 'Donne italiane di 16–70 anni' },
};
const DIMS = ['eta', 'titolo', 'stato_civile', 'condizione', 'ripartizione'];
const coppia = (k, p, f, d = 'totale', g = 'totale') => {
  const c = COPPIE[k];
  const a = cella(c.anni[0], c.pop[0], p, f, d, g)?.v, b = cella(c.anni[1], c.pop[1], p, f, d, g)?.v;
  return a === undefined || b === undefined ? undefined : [a, b];
};
const D = {};
for (const p of ORDINE) {
  D[p] = {};
  for (const [f] of FORME) {
    D[p][f] = {};
    for (const k of Object.keys(COPPIE)) {
      const tot = coppia(k, p, f);
      if (!tot) continue;
      const dim = {};
      for (const d of DIMS) {
        const gs = DIMENSIONI[d].gruppi.map(([g, t]) => ({ t, v: coppia(k, p, f, d, g) })).filter((r) => r.v);
        if (gs.length) dim[d] = gs;
      }
      D[p][f][k] = { tot, dim };
    }
  }
}
const json = { D, periodi: Object.fromEntries(ORDINE.map((p) => [p, PERIODI[p]])), forme: Object.fromEntries(FORME),
  coppie: Object.fromEntries(Object.entries(COPPIE).map(([k, c]) => [k, { anni: c.anni, testo: c.testo }])),
  dim: Object.fromEntries(DIMS.map((d) => [d, DIMENSIONI[d].nome])) };
---
<div class="sic-cf">
  <div class="sic-avviso">Le tre rilevazioni non si leggono come una sola serie. Il 2006 e il 2014 si confrontano su tutte le donne di 16–70 anni; il 2014 e il 2025 solo sulle italiane di 16–70 anni, e solo per gli ultimi 5 anni. Il dato 2025 «nel corso della vita» riguarda le donne di 16–75 anni e non si confronta.</div>

  <section class="sic-blocco" id="sic-cf-comandi">
    <h3>Su 100 donne, prima e dopo</h3>
    <p class="sic-sotto">Ogni coppia è fatta di due quadrati da 100 donne. Nel secondo, i quadratini vuoti sono le donne «in meno» rispetto alla rilevazione precedente, quelli con il punto le donne «in più». Periodo e forma scelti qui valgono anche per la parte qui sotto.</p>
    <div class="sic-schede" data-periodi role="group" aria-label="Periodo">
      {ORDINE.map((p, i) => <button type="button" class="sic-scheda" data-periodo={p} aria-selected={i === 0 ? 'true' : 'false'}>{PERIODI[p]}</button>)}
    </div>
    <label class="sic-cl-forma">Forma
      <select data-forma>{FORME.map(([f, t]) => <option value={f}>{t}</option>)}</select>
    </label>
    <div class="sic-cf-leg" aria-hidden="true"><span><i></i>Hanno subito violenza</span><span><i class="meno"></i>In meno rispetto a prima</span><span><i class="piu"></i>In più rispetto a prima</span></div>
    <div class="sic-cf-coppie" data-tot></div>
    <p class="sic-fonte">2006: tavole Istat 2006; ultimi 5 anni dal report 2014, prospetto 8. 2014: banca dati Istat. 2025: report 2025, prospetto 5.</p>
  </section>

  <section class="sic-blocco">
    <h3>Gruppo per gruppo</h3>
    <p class="sic-ora"><span data-ora></span><a href="#sic-cf-comandi">cambia</a></p>
    <p class="sic-sotto">Ogni gruppo è una linea che va dal primo anno al secondo: se scende, il valore è calato; la punta indica la direzione. La linea tratteggiata è il dato di tutte le donne. Le due coppie stanno in due riquadri separati, perché riguardano donne diverse.</p>
    <div class="sic-schede" data-dim role="group" aria-label="Caratteristica">
      {DIMS.map((d) => <button type="button" class="sic-scheda" data-k={d} aria-selected="false">{DIMENSIONI[d].nome}</button>)}
    </div>
    <div class="sic-cf-pend" data-pend></div>
    <p class="sic-fonte">Per l'area geografica del 2014 e per il confronto 2014 → 2025 i valori vengono dai prospetti dei report (2014, prospetto 11; 2025, prospetto 5): la banca dati 2014 non ha le ripartizioni.</p>
  </section>
  <script type="application/json" class="sic-cf-json" set:html={JSON.stringify(json)}></script>
</div>

<style is:global>
  .sic-cf { display:flex; flex-direction:column; gap:18px; }
  .sic-cf-leg { display:flex; flex-wrap:wrap; gap:6px 16px; font-size:.85rem; color:var(--testo-2); }
  .sic-cf-leg span { display:inline-flex; gap:6px; align-items:center; }
  .sic-cf-leg i { width:12px; height:12px; display:inline-block; background:var(--accento); }
  .sic-cf-coppie, .sic-cf-pend { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
  .sic-cf-coppia { display:flex; flex-direction:column; gap:8px; min-width:0; }
  .sic-cf-coppia h4, .sic-cf-pend h4 { font-family:var(--titoli); font-size:1rem; margin:0; }
  .sic-cf-coppia h4 small, .sic-cf-pend h4 small { display:block; font-family:var(--corpo); font-weight:400; font-size:.82rem; color:var(--testo-3); }
  .sic-cf-q2 { display:flex; gap:16px; flex-wrap:wrap; }
  .sic-cf-q2 figure { margin:0; display:grid; gap:4px; justify-items:start; }
  .sic-cf-q2 figcaption { font-family:var(--titoli); font-weight:600; font-size:.9rem; font-variant-numeric:tabular-nums; }
  .sic-cf-q { display:grid; grid-template-columns:repeat(10,1fr); gap:2px; width:120px; }
  .sic-cf-q i { aspect-ratio:1; background:var(--info-vuoto); display:block; border-radius:1px; }
  .sic-cf-q i.si { background:var(--accento); }
  .sic-cf i.meno { background:transparent; outline:1.5px solid var(--accento); outline-offset:-1.5px; }
  .sic-cf i.piu { background:var(--accento); background-image:radial-gradient(circle, var(--carta) 0 28%, transparent 30%); }
  .sic-cf-frase { font-family:var(--titoli); font-weight:600; font-size:1.3rem; line-height:1.25; margin:0; }
  .sic-cf-pend > div { display:flex; flex-direction:column; gap:6px; min-width:0; }
  .sic-cf-pend svg { width:100%; max-width:420px; height:auto; display:block; }
  @media (max-width:640px) { .sic-cf-coppie, .sic-cf-pend { grid-template-columns:minmax(0,1fr); } }
</style>

<script>
  const fmt = (v: number) => v.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const punti = (d: number) => `${d > 0 ? '+' : d < 0 ? '−' : ''}${fmt(Math.abs(d))} punti`;
  const CORTO: Record<string, string> = { 'Dirigenti, imprenditrici, libere prof.': 'Dirigenti, libere prof.', 'Direttive, quadri, impiegate': 'Impiegate e quadri',
    'Laurea, post-secondario': 'Laurea o più', 'Separata o divorziata': 'Separata, divorziata', 'In cerca di occupazione': 'In cerca di lavoro' };
  function quadrato(prima: number, dopo: number) {
    const a = Math.round(prima), b = Math.round(dopo);
    return `<span class="sic-cf-q" aria-hidden="true">${Array.from({ length: 100 }, (_, j) =>
      j < Math.min(a, b) ? '<i class="si"></i>' : j < a ? '<i class="meno"></i>' : j < b ? '<i class="piu"></i>' : '<i></i>').join('')}</span>`;
  }
  document.querySelectorAll<HTMLElement>('.sic-cf').forEach((root) => {
    const J = JSON.parse(root.querySelector('.sic-cf-json')!.textContent!);
    const st: { p: string; f: string; d: string | null } = { p: Object.keys(J.periodi)[0], f: 'fisica_o_sessuale', d: null };
    const nonC = (k: string) => { const c = J.coppie[k]; return `<div class="sic-cf-coppia"><h4>${c.anni.join(' → ')}<small>${c.testo}</small></h4><p class="sic-sotto">Si confronta solo per gli ultimi 5 anni.</p></div>`; };

    function totali() {
      const X = J.D[st.p][st.f];
      root.querySelector('[data-tot]')!.innerHTML = Object.keys(J.coppie).map((k) => {
        if (!X[k]) return nonC(k);
        const c = J.coppie[k], [a, b] = X[k].tot, d = Math.round(b) - Math.round(a);
        const frase = d === 0 ? 'Più o meno lo stesso numero di donne su 100' : `Circa ${Math.abs(d)} ${Math.abs(d) === 1 ? 'donna' : 'donne'} su 100 ${d < 0 ? 'in meno' : 'in più'}`;
        return `<div class="sic-cf-coppia"><h4>${c.anni.join(' → ')}<small>${c.testo}</small></h4>
          <div class="sic-cf-q2"><figure role="img" aria-label="${c.anni[0]}: ${fmt(a)}%">${quadrato(a, a)}<figcaption>${c.anni[0]} · ${fmt(a)}%</figcaption></figure>
          <figure role="img" aria-label="${c.anni[1]}: ${fmt(b)}%">${quadrato(a, b)}<figcaption>${c.anni[1]} · ${fmt(b)}%</figcaption></figure></div>
          <p class="sic-cf-frase">${frase}</p><p class="sic-sotto">${punti(b - a)}</p></div>`;
      }).join('');
    }

    function pendenze() {
      root.querySelector('[data-ora]')!.textContent = `${J.forme[st.f]}, ${J.periodi[st.p].toLowerCase()}.`;
      root.querySelectorAll<HTMLElement>('[data-dim] .sic-scheda').forEach((b) => {
        const ce = Object.values(J.D[st.p][st.f]).some((x: any) => x.dim[b.dataset.k!]);
        b.hidden = !ce;
        b.setAttribute('aria-selected', String(b.dataset.k === st.d));
      });
      const box = root.querySelector('[data-pend]')!;
      const X = J.D[st.p][st.f];
      if (!st.d) { box.innerHTML = '<p class="sic-sotto">Scegli una caratteristica per vedere i gruppi.</p>'; return; }
      if (!Object.values(X).some((x: any) => x.dim[st.d!])) { box.innerHTML = `<p class="sic-sotto">${J.dim[st.d]}: il confronto c'è solo per gli ultimi 5 anni. Scegli un'altra caratteristica.</p>`; return; }
      const pannelli = Object.keys(J.coppie).map((k) => {
        if (!X[k]) return [k, null];
        const righe = [{ t: 'Tutte le donne', v: X[k].tot, tot: true }, ...(X[k].dim[st.d!] || []).map((g: any) => ({ t: CORTO[g.t] || g.t, v: g.v, tot: false }))];
        return [k, righe];
      }) as [string, any[] | null][];
      const vals = pannelli.flatMap(([, r]) => (r || []).flatMap((x) => x.v));
      const M = Math.max(20, Math.ceil(Math.max(...vals) / 10) * 10);
      const W = 330, H = 300, X0 = 44, X1 = 124, T = 36, B = H - 14;
      const y = (v: number) => B - (v / M) * (B - T);
      box.innerHTML = pannelli.map(([k, righe]) => {
        if (!righe) return nonC(k);
        const c = J.coppie[k];
        let s = '';
        for (let t = 0; t <= M; t += 10) s += `<line x1="${X0 - 4}" x2="${X1 + 4}" y1="${y(t)}" y2="${y(t)}" stroke="var(--griglia)"/><text x="0" y="${y(t) + 4}" font-size="11" fill="var(--testo-3)">${t}%</text>`;
        s += `<text x="${X0}" y="14" font-size="13" font-weight="700" text-anchor="middle" fill="var(--testo)">${c.anni[0]}</text><text x="${X1}" y="14" font-size="13" font-weight="700" text-anchor="middle" fill="var(--testo)">${c.anni[1]}</text>`;
        for (const r of righe) {
          const [a, b] = r.v, ya = y(a), yb = y(b);
          s += `<line x1="${X0}" x2="${X1}" y1="${ya}" y2="${yb}" stroke="var(--accento)" stroke-width="${r.tot ? 2.5 : 1.6}"${r.tot ? ' stroke-dasharray="6 4"' : ''}/>`;
          s += `<circle cx="${X0}" cy="${ya}" r="${r.tot ? 4.5 : 3.5}" fill="var(--accento)"/>`;
          s += b < a ? `<path d="M${X1} ${yb + 5}L${X1 + 5} ${yb - 3}L${X1 - 5} ${yb - 3}Z" fill="var(--accento)"/>` : `<path d="M${X1} ${yb - 5}L${X1 + 5} ${yb + 3}L${X1 - 5} ${yb + 3}Z" fill="var(--accento)"/>`;
        }
        const lab = righe.map((r) => ({ r, yy: y(r.v[1]) })).sort((p, q) => p.yy - q.yy);
        for (let i = 1; i < lab.length; i++) if (lab[i].yy - lab[i - 1].yy < 14) lab[i].yy = lab[i - 1].yy + 14;
        for (const { r, yy } of lab) s += `<text x="${X1 + 10}" y="${yy + 4}" font-size="11.5" fill="var(--testo)"${r.tot ? ' font-weight="700"' : ''}>${r.t} <tspan fill="var(--testo-2)" font-weight="400">${fmt(r.v[0])} → ${fmt(r.v[1])}</tspan></text>`;
        const HH = Math.max(H, lab[lab.length - 1].yy + 12);
        const aria = righe.map((r) => `${r.t}: da ${fmt(r.v[0])}% a ${fmt(r.v[1])}%`).join('; ');
        return `<div><h4>${c.anni.join(' → ')}<small>${c.testo}</small></h4><svg viewBox="0 0 ${W} ${HH}" role="img" aria-label="${aria}">${s}</svg></div>`;
      }).join('');
    }

    const tutto = () => { totali(); pendenze(); };
    root.querySelector('[data-periodi]')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.sic-scheda'); if (!b) return;
      st.p = b.dataset.periodo!;
      root.querySelectorAll('[data-periodi] .sic-scheda').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      tutto();
    });
    root.querySelector<HTMLSelectElement>('[data-forma]')!.addEventListener('change', (e) => { st.f = (e.target as HTMLSelectElement).value; tutto(); });
    root.querySelector('[data-dim]')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.sic-scheda'); if (!b) return;
      st.d = b.dataset.k!; pendenze();
    });
    tutto();
  });
</script>
