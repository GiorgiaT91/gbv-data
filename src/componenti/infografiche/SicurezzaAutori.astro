---
// «Chi è stato» (2014, scelto da Giorgia il 20/11/2026): ogni tipo di autore è un cerchio tratteggiato da 100 donne con dentro
// un cerchio pieno di area proporzionale al dato. Tre gruppi: uomini non partner, persone conosciute, partner ed ex.
// Le basi cambiano: non partner su tutte le donne; partner o ex su chi ha o ha avuto un partner; partner attuale su chi ha
// un partner; ex su chi ha un ex (codici.csv, DATA_TYPE PNP/CFP/CP/FP). Periodo e forma arrivano dalla barra comune (`evento`).
import { PERIODI, FORME_TUTTE, cella } from '../../lib/sicurezza.js';

interface Props { anno: string; popolazione: string; periodi: string[]; evento: string; nota: string; comandi: string; popolazioni?: Record<string, string> }
const { anno, popolazione, periodi, evento, nota, comandi, popolazioni = {} } = Astro.props;
const popDi = (p) => popolazioni[p] ?? popolazione;
// Età della popolazione, dal nome (tutte_16_70 → 16–70).
const ETA = Object.fromEntries(periodi.map((p) => [p, popDi(p).split('_').slice(1).join('–')]));
const AUTORI = ['non_partner', 'sconosciuto', 'persona_conosciuta', 'non_partner_non_specificato', 'conoscente', 'amico', 'parente', 'collega',
  'amico_di_famiglia', 'partner_o_ex', 'partner_attuale', 'ex_partner'];
const D = {};
for (const p of periodi) {
  D[p] = {};
  for (const [f] of FORME_TUTTE) {
    D[p][f] = Object.fromEntries(AUTORI.map((a) => [a, cella(anno, popDi(p), p, f, 'totale', 'totale', a)?.v]).filter((r) => r[1] !== undefined));
  }
}
---
<section class="sic-blocco sic-au">
  <h3>Chi è stato</h3>
  <p class="sic-ora"><span data-ora></span><a href={`#${comandi}`}>cambia</a></p>
  <p class="sic-sotto">Il cerchio tratteggiato sono 100 donne; quello pieno, le donne che hanno subito violenza da quel tipo di autore. L'area del cerchio pieno è proporzionale al dato.</p>
  <div class="sic-au-gruppo" data-np></div>
  <div class="sic-au-gruppo" data-p></div>
  <p class="sic-fonte">{nota}</p>
  <script type="application/json" class="sic-au-json" set:html={JSON.stringify({ D, ETA, evento, forme: Object.fromEntries(FORME_TUTTE), periodi: PERIODI })}></script>
</section>

<style is:global>
  .sic-au-gruppo { display:grid; gap:10px; }
  .sic-au-gruppo + .sic-au-gruppo { border-top:1px solid var(--info-linea); padding-top:14px; }
  .sic-au-gruppo h4 { font-family:var(--titoli); font-size:1rem; margin:0; }
  .sic-au-gruppo h5 { font-size:.9rem; font-weight:600; color:var(--testo-2); margin:6px 0 0; }
  .sic-au-cerchi { display:grid; grid-template-columns:repeat(auto-fill,minmax(118px,1fr)); gap:18px 12px; }
  .sic-au-c { display:grid; justify-items:center; text-align:center; gap:3px; }
  .sic-au-c svg { width:100%; max-width:100px; height:auto; }
  .sic-au-c b { font-family:var(--titoli); font-size:1.1rem; font-variant-numeric:tabular-nums; }
  .sic-au-c span { font-size:.85rem; line-height:1.25; }
  .sic-au-c small { font-size:.72rem; color:var(--testo-3); line-height:1.25; }
</style>

<script>
  const fmt = (v: number) => v.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  function cerchio(v: number | undefined, t: string, nota = '') {
    if (v === undefined) return '';
    const R = 46, r = R * Math.sqrt(v / 100);
    return `<div class="sic-au-c" role="img" aria-label="${t}: ${fmt(v)}%${nota ? ', ' + nota : ''}"><svg viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="${R}" fill="none" stroke="var(--testo-3)" stroke-dasharray="3 3"/>
      <circle cx="50" cy="${96 - r}" r="${Math.max(r, 1.2)}" fill="var(--accento)"/></svg>
      <b>${fmt(v)}%</b><span>${t}</span>${nota ? `<small>${nota}</small>` : ''}</div>`;
  }
  document.querySelectorAll<HTMLElement>('.sic-au').forEach((root) => {
    const J = JSON.parse(root.querySelector('.sic-au-json')!.textContent!);
    const st = { p: Object.keys(J.D)[0], f: 'fisica_o_sessuale' };
    function disegna() {
      root.querySelector('[data-ora]')!.textContent = `${J.forme[st.f]}, ${J.periodi[st.p].toLowerCase()}.`;
      const A = J.D[st.p][st.f];
      const conosciuti = [['conoscente', 'Un conoscente'], ['amico', 'Un amico'], ['parente', 'Un parente'], ['collega', 'Un collega'], ['amico_di_famiglia', 'Un amico di famiglia']]
        .map(([k, t]) => [t, A[k]] as [string, number]).filter((r) => r[1] !== undefined).sort((a, b) => b[1] - a[1]);
      root.querySelector('[data-np]')!.innerHTML = `<h4>Uomini che non sono il partner</h4>
        <p class="sic-sotto">Su 100 donne di ${J.ETA[st.p]} anni. Una donna può aver subito violenza da più autori: i cerchi non si sommano.</p>
        <div class="sic-au-cerchi">${cerchio(A.non_partner, 'Un uomo non partner', 'tutti insieme')}${cerchio(A.sconosciuto, 'Uno sconosciuto')}${cerchio(A.persona_conosciuta, 'Una persona conosciuta', 'tutte insieme')}${cerchio(A.non_partner_non_specificato, 'Autore non indicato')}</div>
        ${conosciuti.length ? `<h5>Fra le persone conosciute</h5><div class="sic-au-cerchi">${conosciuti.map(([t, v]) => cerchio(v, t)).join('')}</div>` : ''}`;
      root.querySelector('[data-p]')!.innerHTML = `<h4>Partner ed ex partner</h4>
        <p class="sic-sotto">Ogni cerchio è calcolato su un gruppo di donne diverso, scritto sotto: non si sommano e non si confrontano con i cerchi sopra.</p>
        <div class="sic-au-cerchi">${cerchio(A.partner_o_ex, 'Partner o ex partner', 'su 100 donne che hanno o hanno avuto un partner')}${cerchio(A.partner_attuale, 'Il partner attuale', 'su 100 donne che oggi hanno un partner')}${cerchio(A.ex_partner, 'Un ex partner', 'su 100 donne che hanno un ex partner')}</div>`;
    }
    document.addEventListener(J.evento, (e: Event) => { const d = (e as CustomEvent).detail; st.p = d.p; st.f = d.f; disegna(); });
    disegna();
  });
</script>
