---
// Riquadro 2014 della domanda 1: indagine Istat sulla sicurezza delle donne, donne di 16-70 anni (scelto da Giorgia il 20/11/2026).
// Periodo e forma, scelti nel primo blocco (come nel 2006), valgono per tutte e quattro le parti: classifica dei gruppi (come il 2006, con filtro per autore e limitazioni),
// chi è stato (cerchi da 100), regioni in fila con forme per area, italiane e straniere (quadratini e pallini).
// Dati: dati/istat-sicurezza-donne/dati.csv, righe «prevalenza» (banca dati Istat, indagine 2014).
import SicurezzaClassifica from './SicurezzaClassifica.astro';
import SicurezzaAutori from './SicurezzaAutori.astro';
import SicurezzaRegioni from './SicurezzaRegioni.astro';
import SicurezzaCittadinanza from './SicurezzaCittadinanza.astro';

const PER = ['nella_vita', 'ultimi_5_anni', 'ultimi_12_mesi'];
const EVENTO = 'sic-2014';
const BD = 'Fonte: Istat, banca dati dell\'indagine sulla sicurezza delle donne 2014, donne di 16–70 anni';
const NOTA = `${BD} (dataset «Tipo di autore…» e «Cittadinanza…»).`;
---
<SicurezzaClassifica
  id="sic-c14" anno="2014" popolazione="tutte_16_70" periodi={PER}
  dimensioni={['eta', 'titolo', 'stato_civile', 'condizione', 'limitazioni', 'ripartizione']}
  righeAutore={true} filtroAutore={true} evento={EVENTO} basePartner="su 100 donne che hanno o hanno avuto un partner"
  sotto="Tutte le donne di 16–70 anni, italiane e straniere. Ogni quadrato è un gruppo di donne: i quadratini pieni sono quelle che hanno subito violenza, su 100. Il quadrato tratteggiato «Tutte le donne» è il totale: i gruppi prima hanno valori più alti del totale, quelli dopo più bassi. L'area geografica c'è solo per gli ultimi 5 anni; le regioni sono nella parte qui sotto. Periodo e forma scelti qui valgono per tutte le parti del 2014."
  note={{ nella_vita: NOTA, ultimi_5_anni: `${NOTA} Area geografica: report Istat 2014, prospetto 11.`, ultimi_12_mesi: NOTA }}
/>
<SicurezzaAutori anno="2014" popolazione="tutte_16_70" periodi={PER} evento={EVENTO} comandi="sic-c14" nota={`${BD}, dataset «Tipo di autore…».`} />
<SicurezzaRegioni anno="2014" popolazione="tutte_16_70" periodi={PER} evento={EVENTO} comandi="sic-c14" nota={`${BD}, dataset «Tipo di autore e regione».`} />
<SicurezzaCittadinanza anno="2014" periodi={PER} dimensioni={['eta', 'titolo', 'stato_civile', 'condizione', 'limitazioni']} evento={EVENTO} comandi="sic-c14" nota={`${BD}, dataset «Cittadinanza…».`} />
