---
// Confronto 2018-2023: le 15 affermazioni presenti in entrambe le rilevazioni, totale Italia.
// Due punti per affermazione (2018 piccolo, 2023 grande), valori scritti accanto. Solo dati delle tavole:
// 2018 IstatData, 2023 tavole per età (ottobre 2024). Gli indicatori "almeno uno" non si confrontano.
import { richiesto } from '../../lib/dati.js';

const F = 'istat-stereotipi-adulti';
const v = (anno, indicatore, categoria) => richiesto(F, { anno, territorio: 'Italia', indicatore, categoria });
const DA_VERIFICARE = ['HUSFNVIO'];
const GRUPPI = [
  ['Ruoli di genere', 'accordo', {
    MISUCWOR: "Per l'uomo è più importante avere successo nel lavoro",
    MLESHOUS: 'Gli uomini sono meno adatti alle faccende domestiche',
    MPRFAM: "È l'uomo che deve provvedere alla famiglia",
    PRIOMEN: 'Se il lavoro scarseggia, precedenza agli uomini',
    MTAKEDE: "È l'uomo che prende le decisioni più importanti",
  }],
  ['Violenza sessuale', 'accordo', {
    WABLAVO: 'Le donne che non vogliono un rapporto riescono a evitarlo',
    WPROVSEX: 'Le donne possono provocare la violenza con il modo di vestire',
    WSVADRE: 'Se è ubriaca o drogata è almeno in parte responsabile',
    OACVIF: 'Le accuse di violenza sessuale sono spesso false',
    WOFSREM: 'Le donne dicono no ma intendono sì',
    SEWNRAP: 'Le donne serie non vengono violentate',
    HUSFNVIO: 'Se il marito obbliga la moglie non è violenza',
  }],
  ['Violenza e controllo nella coppia', 'accettabile', {
    HABCONTR: 'Controllo abituale del cellulare o dei social della compagna',
    SLGIROC: 'Schiaffo alla fidanzata perché ha flirtato',
    NSMOCC: 'In una coppia ogni tanto ci scappa uno schiaffo',
  }],
];
const gruppi = GRUPPI.map(([titolo, ind, voci]) => ({
  titolo,
  righe: Object.entries(voci).map(([c, testo]) => ({ testo, avviso: DA_VERIFICARE.includes(c), a: v(2018, ind, c), b: v(2023, ind, c) })),
}));
const XMAX = 40;
const X = (n) => `${(n / XMAX * 100).toFixed(2)}%`;
const fmt = (n) => n.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const TACCHE = [0, 10, 20, 30, 40];
---
<div class="st-cmp">
  <div class="card">
    <div class="legend">
      <span><i class="dot vecchio"></i>2018 (cerchio piccolo)</span>
      <span><i class="dot nuovo"></i>2023 (cerchio grande)</span>
      <span>Valori in %, totale Italia</span>
    </div>
    {gruppi.map((g) => (
      <div class="gruppo">
        <h3>{g.titolo}</h3>
        <div class="riga asse" aria-hidden="true"><span></span><div class="pista">{TACCHE.map((t) => <em style={`left:${X(t)}`}>{t}%</em>)}</div><span></span></div>
        {g.righe.map((r) => (
          <div class="riga">
            <p>{r.avviso && '⚠ '}{r.testo}</p>
            <div class="pista" role="img" aria-label={`${r.testo}: 2018 ${fmt(r.a)}%, 2023 ${fmt(r.b)}%`}>
              <span class="tratto" style={`left:${X(Math.min(r.a, r.b))};width:${X(Math.abs(r.a - r.b))}`}></span>
              <span class="p18" style={`left:${X(r.a)}`}></span>
              <span class="p23" style={`left:${X(r.b)}`}></span>
            </div>
            <span class="valori">2018 {fmt(r.a)}% · <b>2023 {fmt(r.b)}%</b></span>
          </div>
        ))}
      </div>
    ))}
  </div>
  <p class="note">⚠ "Se il marito obbliga la moglie… non è violenza": la formulazione nei due questionari è da verificare prima di confrontare i valori.</p>
  <p class="src">Fonte: Istat. 2018: IstatData, RUOLIGEN_4, 7 e 10. 2023: tavole per età (ottobre 2024), tavole 2, 3 e 4.</p>
</div>

<style>
  .st-cmp { --fg:#16181D; --muted:#55585F; --line:#dedbe5; --accent:#5A2D82; --old:#a993d3; display:flex; flex-direction:column; gap:14px; color:var(--fg); font-size:15px; line-height:1.5; }
  .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:20px; display:flex; flex-direction:column; gap:18px; min-width:0; }
  .legend { display:flex; flex-wrap:wrap; gap:14px; font-size:.8rem; color:var(--muted); }
  .legend span { display:inline-flex; align-items:center; gap:6px; }
  .dot { display:inline-block; border-radius:50%; }
  .dot.vecchio { width:10px; height:10px; background:var(--old); }
  .dot.nuovo { width:13px; height:13px; background:var(--accent); }
  .gruppo { display:flex; flex-direction:column; gap:4px; }
  h3 { margin:0; font-family:var(--corpo); font-size:.78rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }
  .riga { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) 11.5em; gap:4px 14px; align-items:center; padding:5px 0; font-size:.85rem; }
  .riga p { margin:0; }
  .pista { position:relative; height:18px; background:repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px 25%); background-size:calc(100% + 1px) 100%; border-right:1px solid var(--line); }
  .asse .pista { background:none; border:0; height:16px; }
  .asse em { position:absolute; transform:translateX(-50%); font-style:normal; font-size:.7rem; color:var(--muted); }
  .tratto { position:absolute; top:8px; height:3px; background:var(--old); }
  .p18, .p23 { position:absolute; top:50%; border-radius:50%; transform:translate(-50%,-50%); }
  .p18 { width:10px; height:10px; background:var(--old); }
  .p23 { width:15px; height:15px; background:var(--accent); border:1.5px solid #fff; }
  .valori { font-size:.78rem; color:var(--muted); font-variant-numeric:tabular-nums; white-space:nowrap; }
  .valori b { color:var(--fg); font-weight:600; }
  .note { margin:0; font-size:.8rem; color:var(--muted); max-width:72ch; }
  .src { margin:0; font-size:.75rem; color:var(--muted); }
  @media (max-width:640px) {
    .riga { grid-template-columns:minmax(0,1fr) auto; gap:4px 10px; }
    .riga p { grid-column:1/-1; }
    .asse > span:first-child { display:none; }
  }
</style>
