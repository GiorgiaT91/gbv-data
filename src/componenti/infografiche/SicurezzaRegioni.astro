---
// Regioni in fila (2014, scelta da Giorgia il 20/11/2026 al posto della mappa): una riga per regione in ordine di valore,
// un segno che va più a destra quanto più alto è il valore; la forma del segno dice l'area (cerchio Nord, quadrato Centro,
// triangolo Sud, rombo Isole). Linea tratteggiata: dato dell'Italia. Periodo e forma dalla barra comune (`evento`).
// Trentino-Alto Adige: le due province autonome, come nei dati Istat.
import { PERIODI, FORME_TUTTE, DIMENSIONI, prev, cella } from '../../lib/sicurezza.js';

interface Props { anno: string; popolazione: string; periodi: string[]; evento: string; nota: string; comandi: string }
const { anno, popolazione, periodi, evento, nota, comandi } = Astro.props;
const D = {};
for (const p of periodi) {
  D[p] = {};
  for (const [f] of FORME_TUTTE) {
    const righe = DIMENSIONI.regione.gruppi.map(([g, t]) => ({ g, t, v: cella(anno, popolazione, p, f, 'regione', g)?.v })).filter((r) => r.v !== undefined);
    if (righe.length) D[p][f] = { italia: prev(anno, popolazione, p, f), righe };
  }
}
---
<section class="sic-blocco sic-rg">
  <h3>Regione per regione</h3>
  <p class="sic-ora"><span data-ora></span><a href={`#${comandi}`}>cambia</a></p>
  <p class="sic-sotto">Le regioni in ordine, dal valore più alto. Più il segno è a destra, più alto è il valore. La forma indica l'area del paese. La linea tratteggiata è il dato di tutta Italia: le regioni a destra della linea sono sopra il dato nazionale, quelle a sinistra sotto.</p>
  <div class="sic-rg-leg" aria-hidden="true">
    <span><svg viewBox="0 0 18 18"><circle cx="9" cy="9" r="6" /></svg>Nord</span>
    <span><svg viewBox="0 0 18 18"><rect x="4" y="4" width="10" height="10" /></svg>Centro</span>
    <span><svg viewBox="0 0 18 18"><path d="M9 2L16 15H2Z" /></svg>Sud</span>
    <span><svg viewBox="0 0 18 18"><path d="M9 2L16 9L9 16L2 9Z" /></svg>Isole</span>
    <span><svg viewBox="0 0 18 18"><line x1="9" x2="9" y1="1" y2="17" class="it" /></svg>Italia</span>
  </div>
  <div class="sic-rg-graf"><svg role="img"></svg></div>
  <p class="sic-fonte">{nota} Trentino-Alto Adige è diviso nelle due province autonome, come nei dati Istat.</p>
  <script type="application/json" class="sic-rg-json" set:html={JSON.stringify({ D, evento, forme: Object.fromEntries(FORME_TUTTE), periodi: PERIODI })}></script>
</section>

<style is:global>
  .sic-rg-leg { display:flex; flex-wrap:wrap; gap:6px 18px; font-size:.85rem; color:var(--testo-2); }
  .sic-rg-leg span { display:inline-flex; align-items:center; gap:6px; }
  .sic-rg-leg svg { width:16px; height:16px; fill:var(--accento); }
  .sic-rg-leg line.it { stroke:var(--testo-2); stroke-dasharray:3 3; }
  .sic-rg-graf svg { width:100%; max-width:560px; height:auto; display:block; margin:0 auto; font-family:var(--corpo); fill:var(--testo); }
</style>

<script>
  const fmt = (v: number) => v.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const stretto = window.matchMedia('(max-width: 640px)');
  const AREA: Record<string, string> = { C: 'cerchio', D: 'cerchio', E: 'quadrato', F: 'triangolo', G: 'rombo' };
  function segno(tipo: string, x: number, y: number, k = 7) {
    const a = 'fill="var(--accento)" stroke="var(--carta)" stroke-width="1.5"';
    if (tipo === 'cerchio') return `<circle cx="${x}" cy="${y}" r="${k}" ${a}/>`;
    if (tipo === 'quadrato') return `<rect x="${x - k + 1}" y="${y - k + 1}" width="${2 * k - 2}" height="${2 * k - 2}" ${a}/>`;
    if (tipo === 'triangolo') return `<path d="M${x} ${y - k - 1}L${x + k + 1} ${y + k - 1}L${x - k - 1} ${y + k - 1}Z" ${a}/>`;
    return `<path d="M${x} ${y - k - 1}L${x + k + 1} ${y}L${x} ${y + k + 1}L${x - k - 1} ${y}Z" ${a}/>`;
  }
  document.querySelectorAll<HTMLElement>('.sic-rg').forEach((root) => {
    const J = JSON.parse(root.querySelector('.sic-rg-json')!.textContent!);
    const st = { p: Object.keys(J.D)[0], f: 'fisica_o_sessuale' };
    const svg = root.querySelector('svg[role="img"]')!;
    function disegna() {
      root.querySelector('[data-ora]')!.textContent = `${J.forme[st.f]}, ${J.periodi[st.p].toLowerCase()}.`;
      const dati = J.D[st.p][st.f];
      if (!dati) { svg.innerHTML = ''; return; }
      const r = [...dati.righe].sort((a: any, b: any) => b.v - a.v), T = dati.italia;
      const vals = r.map((x: any) => x.v), lo = Math.floor(Math.min(...vals, T)) - 1, hi = Math.ceil(Math.max(...vals, T)) + 1;
      const tel = stretto.matches, W = tel ? 340 : 460, X0 = tel ? 176 : 178, X1 = W - (tel ? 14 : 30), RH = 22, top = 30, H = top + r.length * RH + 8;
      const x = (v: number) => X0 + ((v - lo) / (hi - lo)) * (X1 - X0);
      const passo = hi - lo > 24 ? 10 : hi - lo > 10 ? 5 : 2;
      let s = '';
      for (let t = Math.ceil(lo / passo) * passo; t <= hi; t += passo)
        s += `<line x1="${x(t)}" x2="${x(t)}" y1="${top - 6}" y2="${H - 6}" stroke="var(--griglia)"/><text x="${x(t)}" y="${top - 12}" font-size="11" fill="var(--testo-3)" text-anchor="middle">${t}%</text>`;
      s += `<line x1="${x(T)}" x2="${x(T)}" y1="${top - 6}" y2="${H - 6}" stroke="var(--testo-2)" stroke-dasharray="4 4"/><text x="${x(T) + 4}" y="${H + 8}" font-size="11" font-weight="600">Italia ${fmt(T)}%</text>`;
      r.forEach((d: any, i: number) => {
        const yy = top + i * RH + RH / 2;
        s += `<line x1="${X0}" x2="${X1}" y1="${yy}" y2="${yy}" stroke="var(--griglia)"/>`;
        s += `<text x="${X0 - (tel ? 10 : 14)}" y="${yy + 4}" font-size="${tel ? 12 : 13}" text-anchor="end">${d.t} <tspan font-weight="700">${fmt(d.v)}</tspan></text>`;
        s += segno(AREA[d.g[2]], x(d.v), yy);
      });
      svg.setAttribute('viewBox', `0 0 ${W} ${H + 16}`);
      svg.innerHTML = s;
      svg.setAttribute('aria-label', `Regioni in ordine di valore, Italia ${fmt(T)}%: ` + r.map((d: any) => `${d.t} ${fmt(d.v)}%`).join(', '));
    }
    document.addEventListener(J.evento, (e: Event) => { const d = (e as CustomEvent).detail; st.p = d.p; st.f = d.f; disegna(); });
    stretto.addEventListener('change', disegna);
    disegna();
  });
</script>
