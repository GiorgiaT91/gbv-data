---
// Infografica degli stereotipi di genere, adulti 18-74 anni (struttura scelta da Giorgia, 19/11/2026):
// tre riquadri in alto (rilevazione 2023, confronto 2018-2023, rilevazione 2018); toccandone uno i dati
// si aprono sotto, uno alla volta. All'apertura della pagina nessun riquadro è aperto.
// Dati: dati/istat-stereotipi-adulti/dati.csv.
import Stereotipi2023 from './Stereotipi2023.astro';
import StereotipiConfronto from './StereotipiConfronto.astro';
import Stereotipi2018 from './Stereotipi2018.astro';

const RIQUADRI = [
  { id: '2023', anno: '2023', titolo: 'La rilevazione 2023', testo: 'Indagine a sé, maggio-luglio 2023, circa 15.000 persone.',
    fatti: ['3 domande · 20 affermazioni', 'Per età; per sesso solo i ruoli, con dati provvisori'] },
  { id: 'confronto', anno: '2018 · 2023', titolo: 'Le due rilevazioni a confronto', testo: 'Le affermazioni presenti in entrambe le rilevazioni.',
    fatti: ['15 affermazioni', 'Totale Italia, persone di 18-74 anni'] },
  { id: '2018', anno: '2018', titolo: 'La rilevazione 2018', testo: "Modulo dell'indagine sulle forze di lavoro, 2018.",
    fatti: ['6 domande · 21 tavole di dati', 'Per sesso, età, titolo di studio e regione'] },
];
---
<div class="stereotipi">
  <p class="intro">Istat ha condotto due rilevazioni su persone di 18-74 anni, nel 2018 e nel 2023, con domande in parte diverse. I dati sono divisi in tre parti: ciascuna si apre toccando il riquadro.</p>

  <div class="hub">
    {RIQUADRI.map((r) => (
      <>
        <button class="box" id={`ster-b-${r.id}`} data-pannello={`ster-p-${r.id}`} aria-expanded="false" aria-controls={`ster-p-${r.id}`}>
          <span class="anno">{r.anno}</span>
          <span class="titolo">{r.titolo}</span>
          <span class="testo">{r.testo}</span>
          <span class="fatti">{r.fatti.map((f) => <span>{f}</span>)}</span>
          <span class="apri"><span class="o">Apri i dati</span><span class="c">Chiudi</span> <i aria-hidden="true">↓</i></span>
        </button>
        <section class="pannello" id={`ster-p-${r.id}`} aria-labelledby={`ster-t-${r.id}`} hidden>
          <div class="testa">
            <p class="occhiello">{r.anno}</p>
            <h2 id={`ster-t-${r.id}`}>
              {r.id === '2023' && 'Le risposte del 2023'}
              {r.id === 'confronto' && 'Le 15 affermazioni presenti in entrambe le rilevazioni'}
              {r.id === '2018' && 'Le risposte del 2018'}
            </h2>
            {r.id === 'confronto' && <p class="lead">Le due rilevazioni sono state condotte in modo diverso: nel 2018 come modulo dell'indagine sulle forze di lavoro, nel 2023 come indagine a sé. Si confrontano solo le singole affermazioni, non gli indicatori di sintesi.</p>}
          </div>
          {r.id === '2023' && <Stereotipi2023 />}
          {r.id === 'confronto' && <StereotipiConfronto />}
          {r.id === '2018' && <Stereotipi2018 />}
        </section>
      </>
    ))}
  </div>

  <p class="nota">La prossima rilevazione Istat è prevista nel 2026.</p>
</div>

<script>
  // Un riquadro aperto alla volta; un secondo tocco sullo stesso lo chiude.
  const riquadri = [...document.querySelectorAll<HTMLButtonElement>('.stereotipi .box')];
  const riduci = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  riquadri.forEach((b) => b.addEventListener('click', () => {
    const aperto = b.getAttribute('aria-expanded') === 'true';
    riquadri.forEach((x) => {
      x.setAttribute('aria-expanded', 'false');
      document.getElementById(x.dataset.pannello!)!.hidden = true;
    });
    if (aperto) return;
    b.setAttribute('aria-expanded', 'true');
    const p = document.getElementById(b.dataset.pannello!)!;
    p.hidden = false;
    // I grafici misurano la larghezza: avvisa che lo spazio è cambiato
    window.dispatchEvent(new Event('resize'));
    const top = p.getBoundingClientRect().top;
    if (top > innerHeight * 0.8 || top < 0) p.scrollIntoView({ block: 'start', behavior: riduci() ? 'auto' : 'smooth' });
  }));
</script>

<style>
  .stereotipi { --accent:var(--accento); --linea:var(--info-linea); --tenue:var(--testo-3); --chiaro:var(--scala-1); display:flex; flex-direction:column; gap:24px; }
  .intro { margin:0; color:var(--testo-2); max-width:68ch; font-size:17px; }
  .hub { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:14px; align-items:stretch; }
  .box { all:unset; box-sizing:border-box; cursor:pointer; display:flex; flex-direction:column; gap:8px; background:var(--carta); border:1px solid var(--linea); border-radius:10px; padding:18px; min-width:0; }
  .box:hover { border-color:var(--accent); }
  .box:focus-visible { outline:2px solid var(--testo); outline-offset:2px; }
  .box[aria-expanded="true"] { border:2px solid var(--accent); padding:17px; background:var(--chiaro); }
  .anno { font-family:var(--titoli); font-size:1.9rem; font-weight:600; line-height:1; color:var(--accent); font-variant-numeric:tabular-nums; }
  .titolo { font-family:var(--titoli); font-size:1.1rem; font-weight:600; }
  .testo { font-size:.88rem; color:var(--tenue); }
  .fatti { display:flex; flex-direction:column; gap:2px; font-size:.82rem; border-top:1px solid var(--linea); padding-top:8px; }
  .apri { margin-top:auto; padding-top:4px; font-size:.85rem; font-weight:600; color:var(--accent); }
  .apri i { font-style:normal; display:inline-block; transition:transform .2s; }
  .box .c { display:none; }
  .box[aria-expanded="true"] .c { display:inline; }
  .box[aria-expanded="true"] .o { display:none; }
  .box[aria-expanded="true"] .apri i { transform:rotate(180deg); }
  .pannello { grid-column:1 / -1; order:10; display:flex; flex-direction:column; gap:24px; min-width:0; padding-top:8px; }
  .pannello[hidden] { display:none; }
  .testa { display:flex; flex-direction:column; gap:6px; }
  .occhiello { margin:0; font-family:var(--titoli); font-size:.8rem; font-weight:600; letter-spacing:.04em; color:var(--accent); }
  .testa h2 { margin:0; font-size:1.5rem; line-height:1.2; }
  .lead { margin:0; color:var(--tenue); max-width:68ch; }
  .nota { margin:0; font-size:.8rem; color:var(--tenue); }
  @media (prefers-reduced-motion:no-preference) { .pannello { animation:ster-apri .2s ease-out; } @keyframes ster-apri { from { opacity:.4; transform:translateY(-4px); } to { opacity:1; transform:none; } } }
  @media (max-width:760px) {
    .hub { grid-template-columns:minmax(0,1fr); }
    #ster-b-2023 { order:1; } #ster-p-2023 { order:2; }
    #ster-b-confronto { order:3; } #ster-p-confronto { order:4; }
    #ster-b-2018 { order:5; } #ster-p-2018 { order:6; }
  }
</style>
