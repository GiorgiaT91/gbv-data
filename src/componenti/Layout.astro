---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '../stili/globale.css';
import { url } from '../lib/url.js';

const { titolo, descrizione = '', sezione = '' } = Astro.props;
const titoloPagina = titolo ? `${titolo} · GBV-Data` : 'GBV-Data';
// Uscita rapida: sito neutro su cui si atterra premendo "Esci" o il tasto Esc.
const sitoNeutro = 'https://www.google.com/';
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titoloPagina}</title>
  {descrizione && <meta name="description" content={descrizione} />}
  <meta name="robots" content="noindex" />
  <link rel="alternate" type="application/rss+xml" title="GBV-Data · Cosa è cambiato" href={url('/rss.xml')} />
</head>
<body>
  <a class="salta" href="#contenuto">Vai al contenuto</a>
  <a class="uscita-rapida" href={sitoNeutro} rel="noreferrer" data-uscita>
    Esci subito <span class="tasto">Esc</span>
  </a>
  <header class="testata">
    <div class="contenitore">
      <a class="logo" href={url('/')}>GBV-Data</a>
      <nav class="menu" aria-label="Menu principale">
        <a href={url('/')} aria-current={sezione === 'domande' ? 'page' : undefined}>Le domande</a>
        <a href={url('/fonti/')} aria-current={sezione === 'fonti' ? 'page' : undefined}>Le fonti</a>
        <a class="pulsante-1522" href="tel:1522">Chiedi aiuto: 1522</a>
      </nav>
    </div>
  </header>
  <main id="contenuto">
    <div class="contenitore pagina">
      <slot />
      <section class="aiuto" aria-label="Numero antiviolenza e stalking">
        <p>Se tu o qualcuno che conosci siete in pericolo, chiama il 1522. Gratuito, attivo 24 ore su 24.</p>
        <a href="tel:1522">Chiama il 1522</a>
      </section>
    </div>
  </main>
  <footer class="piede">
    <div class="contenitore">
      <nav class="piede-menu" aria-label="Altre pagine">
        <a href={url('/calendario/')}>Calendario dei dati</a>
        <a href={url('/dati/')}>Dati scaricabili</a>
        <a href={url('/cosa-e-cambiato/')}>Cosa è cambiato</a>
        <a href="https://github.com/GiorgiaT91/gbv-data">L'archivio su GitHub</a>
      </nav>
      <p class="avviso-uscita">Il pulsante «Esci subito» e il tasto Esc aprono Google al posto di questa pagina. Non cancellano la cronologia del browser: se temi che qualcuno controlli il tuo dispositivo, usa la navigazione in incognito o cancella la cronologia dopo la visita.</p>
      <span>GBV-Data · dati e codice aperti</span>
    </div>
  </footer>
  <script define:vars={{ sitoNeutro }}>
    // Sostituisce la pagina nella cronologia, così il tasto "indietro" non riporta qui.
    const esci = () => window.location.replace(sitoNeutro);
    document.querySelectorAll('[data-uscita]').forEach((a) =>
      a.addEventListener('click', (e) => { e.preventDefault(); esci(); }),
    );
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') esci(); });
  </script>
</body>
</html>
